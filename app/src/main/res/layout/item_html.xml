<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card" android:layout_width="match_parent"
    android:layout_height="match_parent" android:layout_margin="5dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/icon" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:text="HTML" android:textSize="28sp"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:padding="10dp" android:background="#99000000"
            android:textColor="#FFFFFFFF" android:textSize="15sp"/>
        <TextView android:id="@+id/pin" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="top|end"
            android:padding="8dp" android:text="★" android:textSize="20sp"/>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
