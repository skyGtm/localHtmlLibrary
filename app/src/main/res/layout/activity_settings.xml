<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Settings" android:textSize="26sp" android:textStyle="bold"/>
        <Button android:id="@+id/changeLibrary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Change HTML folder"/>
        <Button android:id="@+id/changeData" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Change app-data folder"/>
        <Button android:id="@+id/backup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Export backup ZIP"/>
        <Button android:id="@+id/restore" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Import backup ZIP"/>
        <Button android:id="@+id/rescan" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Rescan HTML files"/>
    </LinearLayout>
</ScrollView>
